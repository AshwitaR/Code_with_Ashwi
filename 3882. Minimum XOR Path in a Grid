class Solution:
    def minCost(self, grid: list[list[int]]) -> int:
        m, n = len(grid), len(grid[0])
        prev = [set() for _ in range(n)]

        for i in range(m):
            cur = [set() for _ in range(n)]
            for j in range(n):
                v = grid[i][j]
                if i == 0 and j == 0:
                    cur[j].add(v)
                    continue
                if i > 0:
                    for x in prev[j]:
                        cur[j].add(x ^ v)
                if j > 0:
                    for x in cur[j - 1]:
                        cur[j].add(x ^ v)
            prev = cur

        return min(prev[n - 1])