class Solution:
    def minimumCost(self, cost1: int, cost2: int, costBoth: int, need1: int, need2: int) -> int:
        def total(k: int) -> int:
            return k * costBoth + max(0, need1 - k) * cost1 + max(0, need2 - k) * cost2

        return min(total(0), total(min(need1, need2)), total(max(need1, need2)))