class Solution:
    def minAddToMakeValid(self, s: str) -> int:
        open_needed = 0
        unmatched_close = 0
        
        for c in s:
            if c == '(':
                open_needed += 1
            else:
                if open_needed > 0:
                    open_needed -= 1
                else:
                    unmatched_close += 1
        
        return open_needed + unmatched_close