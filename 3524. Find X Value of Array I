from typing import List

class Solution:
    def resultArray(self, nums: List[int], k: int) -> List[int]:
        n = len(nums)
        result = [0] * k
        
        for l in range(n):
            product = 1
            for r in range(l, n):
                product = (product * nums[r]) % k
                result[product] += 1
        
        return result