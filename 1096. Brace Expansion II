class Solution:
    def braceExpansionII(self, expression: str) -> list[str]:
        self.s = expression
        self.i = 0
        
        def parseExpr():
            groups = [parseSeq()]
            while self.i < len(self.s) and self.s[self.i] == ',':
                self.i += 1
                groups.append(parseSeq())
            result = set()
            for g in groups:
                result |= g
            return result
        
        def parseSeq():
            seqSets = []
            while self.i < len(self.s) and self.s[self.i] not in ',}':
                seqSets.append(parseTerm())
            result = {''}
            for s in seqSets:
                result = {a + b for a in result for b in s}
            return result
        
        def parseTerm():
            if self.s[self.i] == '{':
                self.i += 1
                inner = parseExpr()
                self.i += 1
                return inner
            else:
                ch = self.s[self.i]
                self.i += 1
                return {ch}
        
        return sorted(parseExpr())