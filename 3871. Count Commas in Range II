class Solution:
    def countCommas(self, n: int) -> int:
        total = 0
        length = len(str(n))
        
        for d in range(1, length + 1):
            low = 10 ** (d - 1) if d > 1 else 1
            high = min(n, 10 ** d - 1)
            if low > high:
                continue
            count = high - low + 1
            commas = (d - 1) // 3
            total += count * commas
        
        return total