class Solution:
    def minSumOfLengths(self, arr: list[int], target: int) -> int:
        n = len(arr)
        INF = float('inf')
        
        best_ending_at = [INF] * n
        left = 0
        current_sum = 0
        best_so_far = INF
        result = INF
        
        for right in range(n):
            current_sum += arr[right]
            
            while current_sum > target:
                current_sum -= arr[left]
                left += 1
            
            if current_sum == target:
                length = right - left + 1
                if left > 0 and best_ending_at[left - 1] != INF:
                    result = min(result, length + best_ending_at[left - 1])
                best_so_far = min(best_so_far, length)
            
            best_ending_at[right] = best_so_far
        
        return result if result != INF else -1