import random
from collections import Counter
from typing import List

class Solution:
    def smallestUniqueSubarray(self, nums: List[int]) -> int:
        n = len(nums)
        M = (1 << 61) - 1
        B = random.randrange(10**6, M - 1)

        h = [0] * (n + 1)
        p = [1] * (n + 1)
        for i, x in enumerate(nums):
            h[i + 1] = (h[i] * B + x) % M
            p[i + 1] = p[i] * B % M

        def has_unique(L):
            cnt = Counter((h[i + L] - h[i] * p[L]) % M for i in range(n - L + 1))
            return 1 in cnt.values()

        lo, hi = 1, n
        while lo < hi:
            mid = (lo + hi) // 2
            if has_unique(mid):
                hi = mid
            else:
                lo = mid + 1

        return lo