from typing import List

class Solution:
    def sumCounts(self, nums: List[int]) -> int:
        MOD = 10**9 + 7
        n = len(nums)
        B1 = [0] * (n + 2)
        B2 = [0] * (n + 2)

        def add(B, i, v):
            while i <= n + 1:
                B[i] += v
                i += i & -i

        def query(B, i):
            s = 0
            while i > 0:
                s += B[i]
                i -= i & -i
            return s

        def prefix(i):
            return query(B1, i) * i - query(B2, i)

        last = {}
        S2 = 0
        ans = 0

        for j in range(1, n + 1):
            x = nums[j - 1]
            p = last.get(x, 0)
            l, r = p + 1, j

            s = prefix(r) - prefix(l - 1)
            S2 += 2 * s + (r - l + 1)

            add(B1, l, 1)
            add(B1, r + 1, -1)
            add(B2, l, l - 1)
            add(B2, r + 1, -r)

            last[x] = j
            ans = (ans + S2) % MOD

        return ans