import java.util.Arrays;

class Solution {
    private int[][] minDigits23;
    private int[][] dExp = new int[10][4];
    
    public String smallestNumber(String num, long t) {
        long tt = t;
        int a = 0, b = 0, c = 0, d = 0;
        while (tt % 2 == 0) { tt /= 2; a++; }
        while (tt % 3 == 0) { tt /= 3; b++; }
        while (tt % 5 == 0) { tt /= 5; c++; }
        while (tt % 7 == 0) { tt /= 7; d++; }
        if (tt != 1) return "-1";
        
        buildTable(a, b);
        
        dExp[1] = new int[]{0,0,0,0};
        dExp[2] = new int[]{1,0,0,0};
        dExp[3] = new int[]{0,1,0,0};
        dExp[4] = new int[]{2,0,0,0};
        dExp[5] = new int[]{0,0,1,0};
        dExp[6] = new int[]{1,1,0,0};
        dExp[7] = new int[]{0,0,0,1};
        dExp[8] = new int[]{3,0,0,0};
        dExp[9] = new int[]{0,2,0,0};
        
        int n = num.length();
        char[] digits = num.toCharArray();
        
        int firstZero = -1;
        for (int i = 0; i < n; i++) {
            if (digits[i] == '0') { firstZero = i; break; }
        }
        
        if (firstZero == -1) {
            int t2=0,t3=0,t5=0,t7=0;
            for (char ch : digits) {
                int[] e = dExp[ch - '0'];
                t2+=e[0]; t3+=e[1]; t5+=e[2]; t7+=e[3];
            }
            if (t2>=a && t3>=b && t5>=c && t7>=d) return num;
        }
        
        int[] p2 = new int[n+1], p3 = new int[n+1], p5 = new int[n+1], p7 = new int[n+1];
        for (int i = 0; i < n; i++) {
            int dig = digits[i] - '0';
            int[] e = (dig == 0) ? new int[]{0,0,0,0} : dExp[dig];
            p2[i+1]=p2[i]+e[0]; p3[i+1]=p3[i]+e[1]; p5[i+1]=p5[i]+e[2]; p7[i+1]=p7[i]+e[3];
        }
        
        int maxP = (firstZero == -1) ? n-1 : firstZero;
        
        for (int p = maxP; p >= 0; p--) {
            int curDigit = digits[p] - '0';
            for (int dPrime = curDigit+1; dPrime <= 9; dPrime++) {
                int[] e = dExp[dPrime];
                int need2 = Math.max(0, a - (p2[p]+e[0]));
                int need3 = Math.max(0, b - (p3[p]+e[1]));
                int need5 = Math.max(0, c - (p5[p]+e[2]));
                int need7 = Math.max(0, d - (p7[p]+e[3]));
                int remSlots = n - 1 - p;
                if (remSlots >= minDigits23[need2][need3] + need5 + need7) {
                    StringBuilder sb = new StringBuilder();
                    sb.append(num, 0, p);
                    sb.append((char)('0'+dPrime));
                    fillSuffix(sb, remSlots, need2, need3, need5, need7);
                    return sb.toString();
                }
            }
        }
        
        int lMin = minDigits23[a][b] + c + d;
        int newLen = Math.max(n+1, lMin);
        for (int first = 1; first <= 9; first++) {
            int[] e = dExp[first];
            int need2 = Math.max(0, a - e[0]);
            int need3 = Math.max(0, b - e[1]);
            int need5 = Math.max(0, c - e[2]);
            int need7 = Math.max(0, d - e[3]);
            int remSlots = newLen - 1;
            if (remSlots >= minDigits23[need2][need3] + need5 + need7) {
                StringBuilder sb = new StringBuilder();
                sb.append((char)('0'+first));
                fillSuffix(sb, remSlots, need2, need3, need5, need7);
                return sb.toString();
            }
        }
        return "-1";
    }
    
    private void buildTable(int a, int b) {
        minDigits23 = new int[a+1][b+1];
        for (int[] row : minDigits23) Arrays.fill(row, Integer.MAX_VALUE/2);
        minDigits23[0][0] = 0;
        int[][] contrib = {{1,0},{0,1},{2,0},{1,1},{3,0},{0,2}};
        for (int i = 0; i <= a; i++) {
            for (int j = 0; j <= b; j++) {
                if (i == 0 && j == 0) continue;
                int best = Integer.MAX_VALUE/2;
                for (int[] con : contrib) {
                    int pi = Math.max(0, i-con[0]);
                    int pj = Math.max(0, j-con[1]);
                    best = Math.min(best, minDigits23[pi][pj] + 1);
                }
                minDigits23[i][j] = best;
            }
        }
    }
    
    private void fillSuffix(StringBuilder sb, int slots, int need2, int need3, int need5, int need7) {
        for (int pos = 0; pos < slots; pos++) {
            for (int dig = 1; dig <= 9; dig++) {
                int[] e = dExp[dig];
                int n2 = Math.max(0, need2 - e[0]);
                int n3 = Math.max(0, need3 - e[1]);
                int n5 = Math.max(0, need5 - e[2]);
                int n7 = Math.max(0, need7 - e[3]);
                int remAfter = slots - pos - 1;
                if (remAfter >= minDigits23[n2][n3] + n5 + n7) {
                    sb.append((char)('0'+dig));
                    need2=n2; need3=n3; need5=n5; need7=n7;
                    break;
                }
            }
        }
    }
}