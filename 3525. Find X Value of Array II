class Solution:
    def resultArray(self, nums: List[int], k: int, queries: List[List[int]]) -> List[int]:
        n = len(nums)
        n_pad = 1
        while n_pad < n:
            n_pad <<= 1
            
        tree_prod = [1] * (2 * n_pad)
        tree_cnt = [0] * (2 * n_pad * k)
        
        # Initialize leaf nodes
        for i in range(n):
            pos = n_pad + i
            v = nums[i] % k
            tree_prod[pos] = v
            tree_cnt[pos * k + v] = 1
            
        # Build segment tree bottom-up
        for pos in range(n_pad - 1, 0, -1):
            left = 2 * pos
            right = 2 * pos + 1
            pA = tree_prod[left]
            pB = tree_prod[right]
            tree_prod[pos] = (pA * pB) % k
            
            off = pos * k
            offA = left * k
            offB = right * k
            
            for r in range(k):
                tree_cnt[off + r] = tree_cnt[offA + r]
                
            for rB in range(k):
                cB = tree_cnt[offB + rB]
                if cB:
                    tree_cnt[off + (pA * rB) % k] += cB

        def update(idx: int, val: int):
            pos = n_pad + idx
            v = val % k
            off = pos * k
            for r in range(k):
                tree_cnt[off + r] = 0
            tree_prod[pos] = v
            tree_cnt[off + v] = 1
            
            pos //= 2
            while pos > 0:
                left = 2 * pos
                right = 2 * pos + 1
                pA = tree_prod[left]
                pB = tree_prod[right]
                tree_prod[pos] = (pA * pB) % k
                
                off = pos * k
                offA = left * k
                offB = right * k
                
                for r in range(k):
                    tree_cnt[off + r] = tree_cnt[offA + r]
                    
                for rB in range(k):
                    cB = tree_cnt[offB + rB]
                    if cB:
                        tree_cnt[off + (pA * rB) % k] += cB
                        
                pos //= 2

        ans = []
        for idx, val, start, x in queries:
            # 1. Point update
            update(idx, val)
            
            # 2. Query range [start, n - 1]
            L = start + n_pad
            R = (n - 1) + n_pad
            
            left_nodes = []
            right_nodes = []
            while L <= R:
                if L % 2 == 1:
                    left_nodes.append(L)
                    L += 1
                if R % 2 == 0:
                    right_nodes.append(R)
                    R -= 1
                L //= 2
                R //= 2
                
            # Combine nodes in left-to-right order
            nodes = left_nodes + right_nodes[::-1]
            
            acc_prod = 1
            acc_cnt = [0] * k
            
            for node in nodes:
                pB = tree_prod[node]
                offB = node * k
                new_cnt = list(acc_cnt)
                for rB in range(k):
                    cB = tree_cnt[offB + rB]
                    if cB:
                        new_cnt[(acc_prod * rB) % k] += cB
                acc_prod = (acc_prod * pB) % k
                acc_cnt = new_cnt
                
            ans.append(acc_cnt[x])
            
        return ans