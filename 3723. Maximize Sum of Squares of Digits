class Solution:
    def maxSumOfSquares(self, num: int, sum: int) -> str:
        if sum > 9 * num:
            return ""
        
        digits = []
        remaining = sum
        
        for _ in range(num):
            d = min(9, remaining)
            digits.append(str(d))
            remaining -= d
        
        return "".join(digits)