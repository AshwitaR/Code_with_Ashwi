class Solution:
    def palindromePath(self, n: int, edges: list[list[int]], s: str, queries: list[str]) -> list[bool]:
        adj = [[] for _ in range(n)]
        for u, v in edges:
            adj[u].append(v)
            adj[v].append(u)

        LOG = max(1, n.bit_length())
        up = [[0] * n for _ in range(LOG)]
        depth = [0] * n
        tin = [0] * n
        tout = [0] * n

        timer = 0
        stack = [(0, -1, 0)]
        while stack:
            node, parent, state = stack.pop()
            if state == 0:
                timer += 1
                tin[node] = timer
                up[0][node] = parent if parent != -1 else 0
                stack.append((node, parent, 1))
                for nxt in adj[node]:
                    if nxt != parent:
                        depth[nxt] = depth[node] + 1
                        stack.append((nxt, node, 0))
            else:
                tout[node] = timer

        for k in range(1, LOG):
            prev, cur = up[k - 1], up[k]
            for v in range(n):
                cur[v] = prev[prev[v]]

        def lca(a, b):
            if depth[a] < depth[b]:
                a, b = b, a
            diff = depth[a] - depth[b]
            for k in range(LOG):
                if (diff >> k) & 1:
                    a = up[k][a]
            if a == b:
                return a
            for k in range(LOG - 1, -1, -1):
                if up[k][a] != up[k][b]:
                    a = up[k][a]
                    b = up[k][b]
            return up[0][a]

        bit = [0] * (n + 3)

        def bit_xor(i, val):
            while i <= n + 1:
                bit[i] ^= val
                i += i & -i

        def prefix(i):
            r = 0
            while i > 0:
                r ^= bit[i]
                i -= i & -i
            return r

        def range_xor(u, val):
            bit_xor(tin[u], val)
            bit_xor(tout[u] + 1, val)

        chars = [ord(c) - 97 for c in s]
        for u in range(n):
            range_xor(u, 1 << chars[u])

        answer = []
        for q in queries:
            parts = q.split()
            if parts[0] == "update":
                u = int(parts[1])
                new = ord(parts[2]) - 97
                if new != chars[u]:
                    range_xor(u, (1 << chars[u]) ^ (1 << new))
                    chars[u] = new
            else:
                u, v = int(parts[1]), int(parts[2])
                l = lca(u, v)
                mask = prefix(tin[u]) ^ prefix(tin[v]) ^ (1 << chars[l])
                answer.append(mask & (mask - 1) == 0)

        return answer