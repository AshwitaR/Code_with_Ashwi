class Solution:
    def minInsertions(self, s: str) -> int:
        insertions = 0
        need = 0
        i = 0
        n = len(s)
        
        while i < n:
            if s[i] == '(':
                need += 2
                if need % 2 == 1:
                    insertions += 1
                    need -= 1
                i += 1
            else:
                if i + 1 < n and s[i + 1] == ')':
                    i += 2
                else:
                    insertions += 1
                    i += 1
                need -= 2
                if need < 0:
                    insertions += 1
                    need += 2
        
        return insertions + need