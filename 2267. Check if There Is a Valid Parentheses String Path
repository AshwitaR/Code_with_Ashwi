class Solution:
    def hasValidPath(self, grid: list[list[str]]) -> bool:
        m, n = len(grid), len(grid[0])
        
        if (m + n - 1) % 2 != 0:
            return False
        if grid[0][0] == ')' or grid[m-1][n-1] == '(':
            return False
        
        dp = [[set() for _ in range(n)] for _ in range(m)]
        dp[0][0].add(1 if grid[0][0] == '(' else -1)
        
        for i in range(m):
            for j in range(n):
                if i == 0 and j == 0:
                    continue
                
                delta = 1 if grid[i][j] == '(' else -1
                possible = set()
                
                if i > 0:
                    for b in dp[i-1][j]:
                        newB = b + delta
                        if newB >= 0:
                            possible.add(newB)
                
                if j > 0:
                    for b in dp[i][j-1]:
                        newB = b + delta
                        if newB >= 0:
                            possible.add(newB)
                
                dp[i][j] = possible
        
        return 0 in dp[m-1][n-1]